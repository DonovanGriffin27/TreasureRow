# Copy to .env.test (never commit .env.test) and point it at a LOCAL test database.
# The test suite creates and deletes users, storefronts, and listings, so it must
# not run against the team's AWS RDS database - conftest.py refuses if it does.
#
#   createdb treasurerow_test
#
# Mac Postgres.app / Homebrew: DB_USER is your Mac username, leave DB_PASSWORD blank
SECRET_KEY=test-secret
ADMIN_USERNAME=test-admin
ADMIN_PASSWORD=test-admin-pass
DB_HOST=localhost
DB_PORT=5432
DB_NAME=treasurerow_test
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
