# Copy this file to .env in same folder and fill in with real values
# never commit .env (to protect credentials, it's already in .gitignore)

FLASK_ENV=development
SECRET_KEY=change-me

# admin login for /auth/admin-login
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# database - local Postgres (use this for testing)
# Mac Postgres.app: DB_USER is your Mac username, leave DB_PASSWORD blank
# Windows: DB_USER is postgres, DB_PASSWORD is password you set during install
DB_HOST=localhost
DB_NAME=treasurerow
DB_USER=postgres
DB_PASSWORD=change-me
DB_PORT=5432

# database - team AWS RDS (check Jira for real values from Jonah)
# to deploy in AWS, put # in front of the first 4 local lines above (keep DB_PORT) and remove # here
#DB_HOST=change-me.us-east-2.rds.amazonaws.com
#DB_NAME=treasurerow
#DB_USER=change-me
#DB_PASSWORD=change-me

# image uploads - can leave blank to save images locally instead of S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=