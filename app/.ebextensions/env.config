# Elastic Beanstalk environment variables.
#
# SECURITY NOTE (Iteration 1 finding, owned by Noah in Iteration 2):
# This file previously had real production values committed here in
# plaintext (DB host, DB password, and the Flask secret key). Those
# credentials have been redacted below and must be rotated and set
# through the Elastic Beanstalk console or `eb setenv` instead of
# being committed to source control.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DB_HOST: CHANGE_ME
    DB_NAME: CHANGE_ME
    DB_USER: CHANGE_ME
    DB_PASSWORD: CHANGE_ME
    DB_PORT: 5432
    DB_SSLMODE: require
    AWS_S3_BUCKET: CHANGE_ME
    AWS_REGION: us-east-2
    SECRET_KEY: CHANGE_ME
