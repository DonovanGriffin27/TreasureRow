# Elastic Beanstalk environment variables.
#
# SECURITY NOTE (Iteration 1 finding elaborated by Noah in Iteration 2):
# This file previously had real production values committed here in
# plaintext by prev group (DB host, DB password, and the Flask secret key). Those
# credentials were rotated and must be set through the Elastic Beanstalk
# console (Configuration -> Environment properties), never committed here.
#
# Only non-secret settings stay in this file. The CHANGE_ME placeholders were
# removed so a missing console value can't fall back to a known placeholder
# (for example SECRET_KEY=CHANGE_ME) - Jonah, Iteration 3
option_settings:
  aws:elasticbeanstalk:application:environment:
    DB_PORT: 5432
    DB_SSLMODE: require
    AWS_REGION: us-east-2